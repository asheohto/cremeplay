{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cremeplay",
  "version": "0.1.0",
  "identifier": "com.cremeplay.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "pnpm build:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Cremeplay",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationGuideModelDownloading,MediaRouter,CalculateNativeWinOcclusion,InterestFeedContentSuggestions,BackForwardCache --disable-background-networking --disable-component-update --disable-sync --disable-speech-api --disable-breakpad --disable-crash-reporter --autoplay-policy=no-user-gesture-required --disk-cache-size=16777216 --media-cache-size=16777216 --js-flags=--max-old-space-size=64"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/cremeplay.ico",
      "icons/icon.ico"
    ]
  }
}
