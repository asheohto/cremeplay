{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Cremeplay Native & Auth",
  "windows": [
    "main",
    "auth"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ],
  "remote": {
    "urls": [
      "https://music.youtube.com/*",
      "https://accounts.google.com/*"
    ]
  }
}
