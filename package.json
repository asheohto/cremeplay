{
  "name": "cremeplay",
  "version": "1.1.0",
  "private": true,
  "description": "90% Native Rust YouTube Music desktop client in Tauri v2 and Rodio",
  "scripts": {
    "dev:frontend": "pnpm --filter cremeplay-frontend dev",
    "build:frontend": "pnpm --filter cremeplay-frontend build",
    "dev": "pnpm build:frontend && tauri dev",
    "build": "pnpm build:frontend && tauri build",
    "build:debug": "pnpm build:frontend && tauri build --debug",
    "rune": "cargo run --bin cremeplay",
    "rune:release": "cargo run --release --bin cremeplay",
    "rune:build": "cargo build --release --workspace",
    "rune:auth": "cargo run --release --bin cremeplay-auth",
    "rune:test": "cargo test --workspace && cargo clippy --workspace",
    "rune:snap": "cargo run --release --bin cremeplay -- --snap snap.png --at 0.5",
    "rune:tree": "cargo run --release --bin cremeplay -- --tree tree.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
